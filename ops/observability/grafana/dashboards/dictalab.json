{
  "uid":"dictalab-readiness", "title":"DictaLab production readiness", "schemaVersion":39,
  "version":3, "refresh":"30s", "time":{"from":"now-30m","to":"now"},
  "panels":[
    {"id":1,"title":"HTTP requests / second","type":"timeseries","gridPos":{"x":0,"y":0,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"sum by (uri) (rate(http_server_requests_seconds_count{job=\"dictalab\"}[5m]))"}]},
    {"id":2,"title":"HTTP p95 by route (seconds)","type":"timeseries","gridPos":{"x":12,"y":0,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95,sum by (le,uri) (rate(http_server_requests_seconds_bucket{job=\"dictalab\"}[5m])))"}]},
    {"id":3,"title":"Server errors / second","type":"timeseries","gridPos":{"x":0,"y":7,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"sum by (uri) (rate(http_server_requests_seconds_count{job=\"dictalab\",status=~\"5..\"}[5m]))"}]},
    {"id":4,"title":"JVM memory bytes","type":"timeseries","gridPos":{"x":12,"y":7,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"sum by (area) (jvm_memory_used_bytes{job=\"dictalab\"})"}]},
    {"id":5,"title":"GC pause seconds / second","type":"timeseries","gridPos":{"x":0,"y":14,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"sum(rate(jvm_gc_pause_seconds_sum{job=\"dictalab\"}[5m]))"}]},
    {"id":6,"title":"Database active / idle / pending","type":"timeseries","gridPos":{"x":12,"y":14,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"hikaricp_connections_active{job=\"dictalab\"}"},{"refId":"B","expr":"hikaricp_connections_idle{job=\"dictalab\"}"},{"refId":"C","expr":"hikaricp_connections_pending{job=\"dictalab\"}"}]},
    {"id":7,"title":"Durable jobs pending / failed","type":"timeseries","gridPos":{"x":0,"y":21,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"dictalab_jobs{job=\"dictalab\"}"}]},
    {"id":8,"title":"Oldest unfinished job seconds","type":"timeseries","gridPos":{"x":12,"y":21,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"dictalab_jobs_oldest_seconds{job=\"dictalab\"}"}]},
    {"id":9,"title":"Provider in-flight / circuit open","type":"timeseries","gridPos":{"x":0,"y":28,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"dictalab_provider_inflight{job=\"dictalab\"}"},{"refId":"B","expr":"dictalab_provider_circuit{job=\"dictalab\"}"}]},
    {"id":10,"title":"Provider p95 seconds","type":"timeseries","gridPos":{"x":12,"y":28,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95,sum by (le,provider) (rate(dictalab_provider_duration_seconds_bucket{job=\"dictalab\"}[5m])))"}]},
    {"id":11,"title":"Audio queue / active workers","type":"timeseries","gridPos":{"x":0,"y":35,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"dictalab_audio_queue{job=\"dictalab\"}"},{"refId":"B","expr":"dictalab_audio_active{job=\"dictalab\"}"}]},
    {"id":12,"title":"Process uptime / verified backup age seconds","type":"timeseries","gridPos":{"x":12,"y":35,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"process_uptime_seconds{job=\"dictalab\"}"},{"refId":"B","expr":"dictalab_backup_age_seconds{job=\"dictalab\"}"}]},
    {"id":13,"title":"AI capability p50 / p95 / p99 seconds","type":"timeseries","gridPos":{"x":0,"y":42,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.50,sum by (le,kind) (rate(dictalab_ai_platform_duration_seconds_bucket[15m])))"},{"refId":"B","expr":"histogram_quantile(0.95,sum by (le,kind) (rate(dictalab_ai_platform_duration_seconds_bucket[15m])))"},{"refId":"C","expr":"histogram_quantile(0.99,sum by (le,kind) (rate(dictalab_ai_platform_duration_seconds_bucket[15m])))"}]},
    {"id":14,"title":"AI durable jobs by status","type":"timeseries","gridPos":{"x":12,"y":42,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"dictalab_ai_jobs{job=\"dictalab-ai\"}"}]},
    {"id":15,"title":"AI oldest queue wait / worker heartbeat","type":"timeseries","gridPos":{"x":0,"y":49,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"dictalab_ai_job_queue_wait_seconds{job=\"dictalab-ai\"}"},{"refId":"B","expr":"dictalab_ai_worker_up{job=\"dictalab-ai\"}"}]},
    {"id":16,"title":"AI capability outcomes / second","type":"timeseries","gridPos":{"x":12,"y":49,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"sum by (kind,outcome) (rate(dictalab_ai_platform_duration_seconds_count[15m]))"},{"refId":"B","expr":"sum by (kind,outcome) (rate(dictalab_ai_platform_shadow_total[15m]))"}]},
    {"id":17,"title":"Gemini rolling RPM / reserved TPM","type":"timeseries","gridPos":{"x":0,"y":56,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"dictalab_gemini_rpm_used{job=\"dictalab-ai\"}"},{"refId":"B","expr":"dictalab_gemini_tpm_reserved{job=\"dictalab-ai\"}"}]},
    {"id":18,"title":"Gemini daily usage / remaining ratio","type":"timeseries","gridPos":{"x":12,"y":56,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"dictalab_gemini_rpd_used{job=\"dictalab-ai\"}"},{"refId":"B","expr":"dictalab_gemini_rpd_remaining_ratio{job=\"dictalab-ai\"}"}]},
    {"id":19,"title":"Gemini shared admission / cooldown ms","type":"timeseries","gridPos":{"x":0,"y":63,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"dictalab_gemini_quota_available{job=\"dictalab-ai\"}"},{"refId":"B","expr":"dictalab_gemini_cooldown_ms{job=\"dictalab-ai\"}"}]},
    {"id":20,"title":"Gemini outcomes / second","type":"timeseries","gridPos":{"x":12,"y":63,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"dictalab-prometheus"},"targets":[{"refId":"A","expr":"sum by (provider,model,outcome) (rate(dictalab_gemini_events_total{job=\"dictalab-ai\"}[15m]))"}]}
  ]
}
