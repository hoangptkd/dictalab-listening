# Routing overlay only. Keep real credentials in protected .env/runtime environment.
DICTALAB_AI_PRODUCTION_MODE=true
DICTALAB_AI_PRIMARY_PROVIDER=shopaikey
DICTALAB_AI_TEXT_PROVIDER=shopaikey
DICTALAB_CONVERSATION_GENERATION_PROVIDER=shopaikey
DICTALAB_COACH_PROVIDER=shopaikey
# The local conversation artifact is not approved for cloud production.
DICTALAB_AI_CONVERSATION_ENABLED=false
DICTALAB_AI_CLOUD_BASE_URL=https://api.shopaikey.com
DICTALAB_AI_CLOUD_MODEL=gemini-2.5-flash
DICTALAB_AI_FALLBACK_ENABLED=false
DICTALAB_AI_JOBS_ENABLED=true
DICTALAB_AI_QUEUE_ENABLED=true
DICTALAB_LISTENING_QUEUE_ENABLED=true
DICTALAB_AI_TTS_MODE=legacy
DICTALAB_AI_COACH_MODE=legacy
DICTALAB_AI_REVIEW_MODE=legacy
