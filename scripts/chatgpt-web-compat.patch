@@ -117,6 +127,38 @@ let chromeProcess = null;
 let shuttingDown = false;
 
 const conversationPages = new Map();
+const pageLastUsed = new Map();
+const MAX_CONVERSATION_TABS = 4;
+const TAB_IDLE_MS = 10 * 60 * 1000;
+
+async function closeConversationPage(id) {
+  const page = conversationPages.get(id);
+  if (page && !page.isClosed()) await page.close();
+  conversationPages.delete(id);
+  pageLastUsed.delete(id);
+}
+
+async function trimConversationPages(limit = MAX_CONVERSATION_TABS, keepId = null) {
+  for (const [id, page] of conversationPages) {
+    if (id !== keepId && (page.isClosed() || Date.now() - (pageLastUsed.get(id) || 0) >= TAB_IDLE_MS)) {
+      await closeConversationPage(id);
+    }
+  }
+  for (const [id] of [...pageLastUsed].sort((a, b) => a[1] - b[1])) {
+    if (conversationPages.size <= limit) break;
+    if (id !== keepId) await closeConversationPage(id);
+  }
+}
+
+// Run cleanup in the same queue as prompts, so an active response is never closed.
+let tabCleanupPending = false;
+const tabCleanupTimer = setInterval(() => {
+  if (shuttingDown || tabCleanupPending) return;
+  tabCleanupPending = true;
+  withQueue(() => trimConversationPages()).catch(error => console.error("[TAB CLEANUP]", error.message))
+    .finally(() => { tabCleanupPending = false; });
+}, 60000);
+tabCleanupTimer.unref();
 
 let queue = Promise.resolve();
 
