@@ -117,6 +127,68 @@ let chromeProcess = null;
 let shuttingDown = false;
 
 const conversationPages = new Map();
+const pageLastUsed = new Map();
+const MAX_CONVERSATION_TABS = 1;
+const TAB_IDLE_MS = 10 * 60 * 1000;
+
+async function closeConversationPage(id) {
+  const page = conversationPages.get(id);
+  if (page && !page.isClosed()) await page.close();
+  conversationPages.delete(id);
+  pageLastUsed.delete(id);
+}
+
+async function trimConversationPages(limit = MAX_CONVERSATION_TABS, keepId = null) {
+  for (const [id, page] of conversationPages) {
+    if (id !== keepId && (page.isClosed() || Date.now() - (pageLastUsed.get(id) || 0) >= TAB_IDLE_MS)) {
+      await closeConversationPage(id);
+    }
+  }
+  for (const [id] of [...pageLastUsed].sort((a, b) => a[1] - b[1])) {
+    if (conversationPages.size <= limit) break;
+    if (id !== keepId) await closeConversationPage(id);
+  }
+}
+
+async function claimConversationPage(context, conversation) {
+  const target = conversation.url || CHATGPT_URL;
+  const pages = context.pages().filter(page => !page.isClosed());
+  // This is the bridge's dedicated Chrome profile. Recover orphaned ChatGPT tabs too.
+  const managed = pages.filter(page => {
+    if (page.url() === "about:blank" || [...conversationPages.values()].includes(page)) return true;
+    try { return new URL(page.url()).origin === new URL(CHATGPT_URL).origin; }
+    catch { return false; }
+  });
+  const cached = conversationPages.get(conversation.id);
+  let page = cached;
+  if (!page || page.isClosed()) {
+    page = managed.find(candidate => candidate.url() === target) || managed[0];
+  }
+  // Prompts are serialized by withQueue; never close a tab while its response is active.
+  for (const oldPage of managed) {
+    if (oldPage !== page) await oldPage.close();
+  }
+  conversationPages.clear();
+  pageLastUsed.clear();
+  if (!page) page = await context.newPage();
+  page.setDefaultTimeout(15000);
+  if (page.url() !== target || (!conversation.url && page !== cached)) {
+    await page.goto(target, { waitUntil: "domcontentloaded", timeout: 30000 });
+  }
+  conversationPages.set(conversation.id, page);
+  pageLastUsed.set(conversation.id, Date.now());
+  return page;
+}
+
+// Run cleanup in the same queue as prompts, so an active response is never closed.
+let tabCleanupPending = false;
+const tabCleanupTimer = setInterval(() => {
+  if (shuttingDown || tabCleanupPending) return;
+  tabCleanupPending = true;
+  withQueue(() => trimConversationPages()).catch(error => console.error("[TAB CLEANUP]", error.message))
+    .finally(() => { tabCleanupPending = false; });
+}, 60000);
+tabCleanupTimer.unref();
 
