+// Only inspect visible UI notices; source transcripts and the composer are untrusted text.
+function isQuotaNotice(text) {
+  return /(?:you(?:'|’)ve|you have) (?:hit|reached).{0,100}limit|(?:usage|message|free plan) limit.{0,100}(?:reached|try again|reset)|you(?:'|’)re out of.{0,40}(?:messages|requests)|(?:đã đạt|đã hết|đã chạm).{0,50}(?:hạn mức|giới hạn)/i.test(text);
+}
+
+async function assertWebQuotaAvailable(page) {
+  const notices = await page.evaluate(() => Array.from(document.querySelectorAll(
+    '[role="alert"], [role="dialog"], [data-testid*="limit"], main p, main span'
+  )).filter(el => !el.closest('[data-message-author-role], #prompt-textarea, nav, aside') &&
+    el.getClientRects().length).map(el => el.innerText || '').filter(text => text.length < 700));
+  if (notices.some(isQuotaNotice)) {
+    const error = new Error('ChatGPT Web displayed an account quota notice; wait before reuse.');
+    error.status = 429;
+    error.code = 'chatgpt_web_quota';
+    throw error;
+  }
+}
+
+async function visibleModelLabel(page) {
+  const selector = page.locator('[data-testid="model-switcher-dropdown-button"]').first();
+  return await selector.count() && await selector.isVisible() ? (await selector.innerText()).trim() : null;
+}
