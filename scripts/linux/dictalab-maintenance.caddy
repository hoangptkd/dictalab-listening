@database_off file {
    root /etc/caddy
    try_files dictalab-maintenance
}
handle @database_off {
    header Retry-After "300"
    header Cache-Control "no-store"
    @api path /api/* /actuator/*
    handle @api {
        header Content-Type "application/json; charset=utf-8"
        respond `{"error":"maintenance","message":"Hệ thống đang bảo trì. Vui lòng quay lại sau."}` 503
    }
    handle {
        header Content-Type "text/html; charset=utf-8"
        respond `<!doctype html><html lang="vi"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>DictaLab · Bảo trì</title><main><h1>DictaLab đang bảo trì</h1><p>Hệ thống tạm ngừng phục vụ. Vui lòng quay lại sau.</p><p><a href="/">Thử lại</a></p></main></html>` 503
    }
}
