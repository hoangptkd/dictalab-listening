[Unit]
Description=DictaLab Java backend
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
User=dictalab
Group=dictalab
WorkingDirectory=/opt/dictalab/app
EnvironmentFile=/etc/dictalab/app.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -XX:+ExitOnOutOfMemoryError -jar /opt/dictalab/app/dictalab.jar --server.address=127.0.0.1 --server.port=18082 --server.forward-headers-strategy=framework --logging.file.name=/var/lib/dictalab/logs/dictalab.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=100
SuccessExitStatus=143
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dictalab

[Install]
WantedBy=multi-user.target
