[Unit]
Description=DictaLab Progress projections
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
User=dictalab-progress
Group=dictalab-progress
WorkingDirectory=/opt/dictalab/services/current
EnvironmentFile=/etc/dictalab/progress.env
ExecStart=/usr/bin/java -Xmx192m -XX:MaxMetaspaceSize=128m -XX:+ExitOnOutOfMemoryError -jar /opt/dictalab/services/current/progress.jar --server.address=127.0.0.1 --server.port=8092
Restart=on-failure
RestartSec=15
TimeoutStopSec=100
SuccessExitStatus=143
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/var/lib/dictalab -/var/lib/dictalab-ai -/etc/dictalab/app.env -/etc/dictalab/ai.env
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=384M
TasksMax=128

[Install]
WantedBy=multi-user.target
