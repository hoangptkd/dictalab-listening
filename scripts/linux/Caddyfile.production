{
    admin off
    default_sni 184.194.89.90
}

https://184.194.89.90 {
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            profile shortlived
            disable_tlsalpn_challenge
        }
    }
    reverse_proxy 127.0.0.1:18082
}

http://184.194.89.90 {
    redir https://184.194.89.90{uri} 308
}
