<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.dictalab</groupId>
    <artifactId>english-dictation</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>DictaLab</name>
    <description>English listening dictation practice from CEFR A1 to B2</description>

    <properties>
        <java.version>17</java.version>
        <project.build.outputTimestamp>2026-10-03T00:00:00Z</project.build.outputTimestamp>
        <dictalab.build.directory>${project.basedir}/target</dictalab.build.directory>
        <aws-sdk.version>2.55.11</aws-sdk.version>
        <!-- Security patches within the current families; remove overrides when Boot's BOM catches up. -->
        <rabbit-amqp-client.version>5.37.0</rabbit-amqp-client.version>
        <tomcat.version>11.0.25</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${aws-sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <directory>${dictalab.build.directory}</directory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
                    <forkedProcessExitTimeoutInSeconds>30</forkedProcessExitTimeoutInSeconds>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Keep this partition complementary; CI checks every Spring context test belongs to integration. -->
        <profile>
            <id>ci-unit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/*IntegrationTest.java</exclude>
                                <exclude>**/ProductionReliabilityTest.java</exclude>
                                <exclude>**/SpaRoutingTest.java</exclude>
                                <exclude>**/EmailOutboxRecoveryTest.java</exclude>
                                <exclude>**/ConcurrencyMatrixTest.java</exclude>
                                <exclude>**/BackendBenchmarkTest.java</exclude>
                                <exclude>**/ReliabilityInfrastructureTest.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ci-integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*IntegrationTest.java</include>
                                <include>**/ProductionReliabilityTest.java</include>
                                <include>**/SpaRoutingTest.java</include>
                                <include>**/EmailOutboxRecoveryTest.java</include>
                                <include>**/ConcurrencyMatrixTest.java</include>
                                <include>**/BackendBenchmarkTest.java</include>
                                <include>**/ReliabilityInfrastructureTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>production-s3</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <!-- Published audio lives in S3; keep the HTML, JS and transcript resources. -->
                            <excludes>
                                <exclude>static/audio/**/*.mp3</exclude>
                                <exclude>static/audio/**/*.wav</exclude>
                                <exclude>static/audio/**/*.m4a</exclude>
                                <exclude>static/audio/**/*.ogg</exclude>
                                <exclude>static/audio/**/*.aac</exclude>
                                <exclude>static/audio/**/*.flac</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>reliability</id>
            <properties>
                <dictalab.testcontainers.postgres-image>postgres:17.11-alpine</dictalab.testcontainers.postgres-image>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <dictalab.testcontainers>true</dictalab.testcontainers>
                                <dictalab.testcontainers.postgres-image>${dictalab.testcontainers.postgres-image}</dictalab.testcontainers.postgres-image>
                                <dictalab.race-tests>true</dictalab.race-tests>
                                <spring.profiles.active>postgres-test</spring.profiles.active>
                                <spring.datasource.hikari.minimum-idle>0</spring.datasource.hikari.minimum-idle>
                                <spring.test.context.cache.maxSize>4</spring.test.context.cache.maxSize>
                            </systemPropertyVariables>
                            <environmentVariables>
                                <DICTALAB_MESSAGING_TEST>true</DICTALAB_MESSAGING_TEST>
                            </environmentVariables>
                            <includes>
                                <include>**/ReliabilityInfrastructureTest.java</include>
                                <include>**/ListeningLearningIntegrationTest.java</include>
                                <include>**/LearningJobsIntegrationTest.java</include>
                                <include>**/AiUsageBudgetIntegrationTest.java</include>
                                <include>**/BackendReadIntegrationTest.java</include>
                                <include>**/PracticeWordCheckIntegrationTest.java</include>
                                <include>**/CapacityReadPathIntegrationTest.java</include>
                                <include>**/QueryOptimizationIntegrationTest.java</include>
                                <include>**/AuthTransactionIntegrationTest.java</include>
                                <include>**/IdleDispatchTest.java</include>
                                <include>**/ConversationIntegrationTest.java</include>
                                <include>**/ListeningComprehensionIntegrationTest.java</include>
                                <include>**/ConcurrencyMatrixTest.java</include>
                                <include>**/EmailOutboxRecoveryTest.java</include>
                                <include>**/RedisRateLimitIntegrationTest.java</include>
                                <include>**/JwtRedisIntegrationTest.java</include>
                                <include>**/ListeningGradingQueueIntegrationTest.java</include>
                                <include>**/AiRabbitQueueIntegrationTest.java</include>
                                <include>**/AiBackgroundJobsIntegrationTest.java</include>
                                <include>**/S3MediaLifecycleIntegrationTest.java</include>
                                <include>**/S3MediaIntegrationTest.java</include>
                                <include>**/S3MediaConfigTest.java</include>
                                <include>**/WorkerShutdownTest.java</include>
                                <include>**/DatabaseDeadlineIntegrationTest.java</include>
                                <include>**/ApiExceptionHandlerTest.java</include>
                                <include>**/MessagingLifecycleConfigTest.java</include>
                                <include>**/RestoreIsolationIntegrationTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
