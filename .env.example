POSTGRES_DB=dictalab
POSTGRES_USER=dictalab_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=15433
APP_PORT=18081
# Optional: use the existing data/postgres-local cluster instead of Docker.
# DICTALAB_PG_CTL=C:/path/to/pgsql/bin/pg_ctl.exe
DICTALAB_MEDIA_ROOT=./data/media
DICTALAB_ADMIN_EMAILS=your-email@example.com

# Liên kết xác minh/đặt lại mật khẩu. Đặt ở môi trường backend, không đưa vào web client.
DICTALAB_PUBLIC_URL=http://localhost:18081
DICTALAB_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Listening Comprehension: khóa chỉ lưu ở môi trường máy chủ
SHOPAIKEY_API_KEY=
SHOPAIKEY_MODEL=claude-sonnet-4-5

# Dictation AI Coach: chatgpt-api-web chạy cùng máy backend, Chrome đã đăng nhập.
DICTALAB_COACH_ENABLED=true
DICTALAB_COACH_URL=http://127.0.0.1:3000/v1/chat/completions
DICTALAB_COACH_MODEL=chatgpt-web
DICTALAB_COACH_TIMEOUT=75s
# Chỉ cần nếu reverse proxy của bridge có xác thực.
DICTALAB_COACH_API_KEY=
# Optional Chrome executable path for scripts/run-local.ps1 -WithCoach.
# DICTALAB_COACH_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Luyện cùng bạn — Voice Room (1-1)
# Origins được phép kết nối WebSocket (phân cách bằng dấu phẩy)
DICTALAB_ALLOWED_ORIGINS=http://localhost:18081
# TURN server để relay audio khi hai thiết bị không kết nối trực tiếp được
# Bỏ trống nếu chưa có TURN (chỉ dùng STUN — gọi qua hai mạng khác nhau có thể thất bại)
DICTALAB_TURN_URL=
DICTALAB_TURN_SECRET=
DICTALAB_TURN_TTL_SECONDS=3600
