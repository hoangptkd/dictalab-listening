POSTGRES_DB=dictalab
POSTGRES_USER=dictalab_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=15433
APP_PORT=18081
DICTALAB_MEDIA_ROOT=./data/media
DICTALAB_ADMIN_EMAILS=your-email@example.com

# Liên kết xác minh/đặt lại mật khẩu. Đặt ở môi trường backend, không đưa vào web client.
DICTALAB_PUBLIC_URL=http://localhost:18081
DICTALAB_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Listening Comprehension: khóa chỉ lưu ở môi trường máy chủ
SHOPAIKEY_API_KEY=
SHOPAIKEY_MODEL=claude-sonnet-4-5

# Luyện cùng bạn — Voice Room (1-1)
# Origins được phép kết nối WebSocket (phân cách bằng dấu phẩy)
DICTALAB_ALLOWED_ORIGINS=http://localhost:18081
# TURN server để relay audio khi hai thiết bị không kết nối trực tiếp được
# Bỏ trống nếu chưa có TURN (chỉ dùng STUN — gọi qua hai mạng khác nhau có thể thất bại)
DICTALAB_TURN_URL=
DICTALAB_TURN_SECRET=
DICTALAB_TURN_TTL_SECONDS=3600
