POSTGRES_DB=dictalab
POSTGRES_USER=dictalab_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=15433
APP_PORT=18081
REDIS_PORT=16379
RABBITMQ_PORT=15672
RABBITMQ_MANAGEMENT_PORT=25672
RABBITMQ_USER=dictalab
RABBITMQ_PASSWORD=change-this-local-rabbit-password
# Optional: use the existing data/postgres-local cluster instead of Docker.
# DICTALAB_PG_CTL=C:/path/to/pgsql/bin/pg_ctl.exe
DICTALAB_MEDIA_ROOT=./data/media
DICTALAB_ADMIN_EMAILS=your-email@example.com

# Liên kết xác minh/đặt lại mật khẩu. Đặt ở môi trường backend, không đưa vào web client.
DICTALAB_PUBLIC_URL=http://localhost:18081
DICTALAB_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Shared rate limit and Listening grading queue. Keep false when services are not running.
DICTALAB_RATE_LIMIT_BACKEND=memory
REDIS_URL=
REDIS_HOST=localhost
# JWT_SIGNING_KEY: Base64 of at least 32 cryptographically random bytes; never commit a real key.
JWT_SIGNING_KEY=
JWT_KEY_ID=1
JWT_PREVIOUS_SIGNING_KEY=
JWT_PREVIOUS_KEY_ID=0
JWT_ACCESS_LIFETIME=10m
JWT_REFRESH_LIFETIME=7d
# false only for HTTP localhost; production HTTPS must use true.
JWT_COOKIE_SECURE=false
DICTALAB_LISTENING_QUEUE_ENABLED=false
RABBITMQ_URL=

# Tất cả AI văn bản: khóa chỉ lưu ở môi trường máy chủ
SHOPAIKEY_API_KEY=
SHOPAIKEY_MODEL=claude-sonnet-4-5
SHOPAIKEY_URL=https://api.shopaikey.com/v1/chat/completions

# Hội thoại AI V1: ShopAIKey tạo câu/chấm/làm rõ, Cartesia đọc. Khóa chỉ ở backend.
DICTALAB_CONVERSATION_ENABLED=true
DICTALAB_CONVERSATION_MODEL=gemini-2.5-flash
CONVERSATION_AUDIO_RETENTION_DAYS=30
CARTESIA_API_KEY=
CARTESIA_VOICE=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
CARTESIA_MODEL=sonic-3.6
CARTESIA_VERSION=2026-08-14

# Dictation AI Coach: dùng chung SHOPAIKEY_API_KEY và SHOPAIKEY_MODEL.
DICTALAB_COACH_ENABLED=true

# Luyện cùng bạn — Voice Room (1-1)
# Origins được phép kết nối WebSocket (phân cách bằng dấu phẩy)
DICTALAB_ALLOWED_ORIGINS=http://localhost:18081
# TURN server để relay audio khi hai thiết bị không kết nối trực tiếp được
# Bỏ trống nếu chưa có TURN (chỉ dùng STUN — gọi qua hai mạng khác nhau có thể thất bại)
# Có thể nhập nhiều URL cách nhau bằng dấu phẩy, ví dụ UDP và TCP trên cổng 3478.
# TURN Windows của dự án chấp nhận TTL tối đa 3600 giây; không đưa shared secret vào frontend.
DICTALAB_TURN_URL=
DICTALAB_TURN_SECRET=
DICTALAB_TURN_TTL_SECONDS=3600
