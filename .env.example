POSTGRES_DB=dictalab
POSTGRES_USER=dictalab_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=15433
APP_PORT=18081
REDIS_PORT=16379
RABBITMQ_PORT=15672
RABBITMQ_MANAGEMENT_PORT=25672
RABBITMQ_USER=dictalab
RABBITMQ_PASSWORD=change-this-local-rabbit-password
# Optional: use the existing data/postgres-local cluster instead of Docker.
# DICTALAB_PG_CTL=C:/path/to/pgsql/bin/pg_ctl.exe
DICTALAB_MEDIA_ROOT=./data/media
# S3 stores admin uploads and generated conversation audio; migrate legacy assets before all-audio mode.
DICTALAB_MEDIA_S3_ENABLED=false
DICTALAB_MEDIA_S3_ALL_AUDIO=false
DICTALAB_MEDIA_S3_PROXY_AUDIO=false
DICTALAB_MEDIA_S3_BUCKET=
DICTALAB_MEDIA_S3_REGION=
DICTALAB_MEDIA_S3_PREFIX=dictalab/audio/
DICTALAB_MEDIA_S3_SIGNED_URL_DURATION=30m
# Configure AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (+ AWS_SESSION_TOKEN for temporary keys)
# in the backend service environment, or use the AWS credential profile / IAM role.
DICTALAB_ADMIN_EMAILS=your-email@example.com

# Liên kết xác minh/đặt lại mật khẩu. Đặt ở môi trường backend, không đưa vào web client.
DICTALAB_PUBLIC_URL=http://localhost:18081
DICTALAB_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Shared rate limit and Listening grading queue. Keep false when services are not running.
DICTALAB_RATE_LIMIT_BACKEND=memory
REDIS_URL=
REDIS_HOST=localhost
# JWT_SIGNING_KEY: Base64 of at least 32 cryptographically random bytes; never commit a real key.
JWT_SIGNING_KEY=
JWT_KEY_ID=1
JWT_PREVIOUS_SIGNING_KEY=
JWT_PREVIOUS_KEY_ID=0
JWT_ACCESS_LIFETIME=10m
JWT_REFRESH_LIFETIME=7d
# false only for HTTP localhost; production HTTPS must use true.
JWT_COOKIE_SECURE=false
DICTALAB_LISTENING_QUEUE_ENABLED=false
DICTALAB_AI_QUEUE_ENABLED=false
DICTALAB_AUDIO_WORKERS=2
DICTALAB_COACH_WORKERS=1
RABBITMQ_URL=

# Tất cả AI văn bản dùng Google Gemini: khóa chỉ lưu ở môi trường máy chủ.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL=gemini-3.5-flash-lite
# Shared Java/Python pool; see docs/ai-platform-runbook.md. Keep real keys outside Git.
# JSON entries require all fields from docs/gemini-providers.example.json.
GEMINI_PROVIDERS_JSON=[]
GEMINI_QUOTA_ENABLED=false
GEMINI_QUOTA_BACKEND=redis
GEMINI_GLOBAL_RPM_LIMIT=39
GEMINI_GLOBAL_RPD_LIMIT=0
# Docker uses redis://redis:6379/0 by default. For a host-side batch runner:
# GEMINI_QUOTA_REDIS_URL=redis://127.0.0.1:16379/0
# Java REDIS_URL and Python GEMINI_QUOTA_REDIS_URL must reach the same Redis database.
AI_ASSESSMENT_TIMEOUT_SECONDS=25
AI_GENERATION_TIMEOUT_SECONDS=25
# Admission reservations are conservative estimates, not provider invoice amounts.
AI_BUDGET_ENABLED=true
AI_BUDGET_GLOBAL_MICROUSD=5000000
AI_BUDGET_USER_MICROUSD=2000000
AI_BUDGET_LLM_RESERVATION_MICROUSD=50000
AI_BUDGET_TTS_RESERVATION_MICROUSD=50000
AI_BUDGET_GLOBAL_CALLS=100
AI_BUDGET_USER_CALLS=40
DICTALAB_SUPPORT_EMAIL=

# Hội thoại AI: Gemini tạo câu và đánh giá/làm rõ, Cartesia đọc. Khóa chỉ ở backend.
DICTALAB_CONVERSATION_ENABLED=true
DICTALAB_CONVERSATION_MODEL=gemini-3.5-flash-lite
# Local pilot: bật bằng -WithConversationLocal hoặc đổi provider thành ollama sau khi kiểm tra chất lượng.
# Ollama chỉ dùng cho local; cloud luôn là Gemini.
DICTALAB_CONVERSATION_GENERATION_PROVIDER=gemini
# Measure first-pass quality; both repair layers stay disabled.
DICTALAB_CONVERSATION_GENERATION_REPAIR_ENABLED=false
DICTALAB_AI_REPAIR_ENABLED=false
DICTALAB_CONVERSATION_LOCAL_BASE_URL=http://127.0.0.1:11434
DICTALAB_CONVERSATION_LOCAL_MODEL=qwen3.5:9b
DICTALAB_CONVERSATION_LOCAL_TIMEOUT_SECONDS=180
CONVERSATION_AUDIO_RETENTION_DAYS=30
CARTESIA_API_KEY=
CARTESIA_VOICE=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
CARTESIA_MODEL=sonic-3.6
CARTESIA_VERSION=2026-08-14

# Coach chọn provider riêng, không đổi provider tạo câu hội thoại.
DICTALAB_COACH_ENABLED=true
DICTALAB_COACH_PROVIDER=gemini
DICTALAB_COACH_LOCAL_BASE_URL=http://127.0.0.1:11434
DICTALAB_COACH_LOCAL_MODEL=qwen3.5:4b
DICTALAB_COACH_LOCAL_TIMEOUT_SECONDS=60

# Luyện cùng bạn — Voice Room (1-1)
# Origins được phép kết nối WebSocket (phân cách bằng dấu phẩy)
DICTALAB_ALLOWED_ORIGINS=http://localhost:18081
# TURN server để relay audio khi hai thiết bị không kết nối trực tiếp được
# Bỏ trống nếu chưa có TURN (chỉ dùng STUN — gọi qua hai mạng khác nhau có thể thất bại)
# Có thể nhập nhiều URL cách nhau bằng dấu phẩy, ví dụ UDP và TCP trên cổng 3478.
# TURN Windows của dự án chấp nhận TTL tối đa 3600 giây; không đưa shared secret vào frontend.
DICTALAB_TURN_URL=
DICTALAB_TURN_SECRET=
DICTALAB_TURN_TTL_SECONDS=3600
# PostgreSQL session bounds also apply to Flyway. Override deliberately for reviewed long migrations.
DB_SESSION_INIT_SQL="SET statement_timeout=15000; SET lock_timeout=3000; SET idle_in_transaction_session_timeout=60000"
# Must exceed the oldest backup/PITR window; cleanup is delayed, not immediate.
DICTALAB_MEDIA_S3_CLEANUP_ENABLED=false
DICTALAB_MEDIA_S3_CLEANUP_RETENTION_DAYS=7
GOOGLE_CLIENT_ID=
# payOS: enable only after identity/bank verification and a working signed webhook.
DICTALAB_BILLING_ENABLED=false
DICTALAB_BILLING_PUBLIC_URL=
DICTALAB_PREMIUM_PRICE_VND=49000
DICTALAB_PREMIUM_DURATION_DAYS=30
DICTALAB_FREE_DAILY_LESSONS=3
DICTALAB_PREMIUM_DAILY_AI=10
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ---------------------------------------------------------------------------
# AI Platform — Python sidecar (services/ai-generation)  [T04]
# ---------------------------------------------------------------------------
# auto selects Gemini in production mode and Ollama in development.
DICTALAB_AI_PRIMARY_PROVIDER=auto
# Java quota/routing must match Python; run-local.ps1 overrides this to ollama.
DICTALAB_AI_TEXT_PROVIDER=gemini
# Compose forwards GEMINI_API_KEY; native Python uses DICTALAB_AI_GEMINI_API_KEY.
DICTALAB_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DICTALAB_AI_GEMINI_MODEL=gemini-3.5-flash-lite
DICTALAB_AI_GEMINI_API_KEY=
DICTALAB_AI_CONVERSATION_ENABLED=true
DICTALAB_AI_MODEL=qwen3.5:9b
DICTALAB_AI_OLLAMA_URL=http://127.0.0.1:11434
DICTALAB_AI_OLLAMA_SERVICE_TOKEN=
DICTALAB_AI_TEMPERATURE=0.3
DICTALAB_AI_TRANSLATION_TEMPERATURE=0.1
DICTALAB_AI_TIMEOUT_SECONDS=180
DICTALAB_AI_MAX_CONCURRENCY=1

# Service-to-service auth token for Python sidecar (leave blank for loopback dev)
DICTALAB_AI_SERVICE_TOKEN=
DICTALAB_AI_PRODUCTION_MODE=false
DICTALAB_AI_CACHE_TTL_SECONDS=900
DICTALAB_AI_ARTIFACT_VERSION=conversation-platform-r1-20261020
# Production requires the hash of an approved artifact with a passing evaluation gate.
DICTALAB_AI_ARTIFACT_SHA256=
DICTALAB_CONVERSATION_PYTHON_BASE_URL=http://127.0.0.1:8091
DICTALAB_CONVERSATION_PYTHON_SERVICE_TOKEN=
DICTALAB_CONVERSATION_PYTHON_TIMEOUT_SECONDS=180
DICTALAB_CONVERSATION_CANARY_ENABLED=false
DICTALAB_CONVERSATION_CANARY_USERS=
DICTALAB_CONVERSATION_CANARY_SESSIONS=
DICTALAB_CONVERSATION_SHADOW_SAMPLE_RATE=0
DICTALAB_CONVERSATION_SHADOW_MAX_REQUESTS_PER_HOUR=10
DICTALAB_CONVERSATION_SHADOW_TIMEOUT_SECONDS=30

# T10/T11: optional background worker. Keep each capability on legacy until its pilot passes.
DICTALAB_AI_JOBS_ENABLED=false
DICTALAB_AI_JOBS_DATABASE=data/ai-jobs.sqlite3
# Protected runtime value; URL-encode broker credentials. Never commit the actual URL.
DICTALAB_AI_RABBITMQ_URL=
DICTALAB_AI_JOB_RETENTION_SECONDS=900
DICTALAB_AI_HTTP_MAX_CONNECTIONS=10
DICTALAB_AI_PLATFORM_BASE_URL=http://127.0.0.1:8091
DICTALAB_AI_JOB_TIMEOUT_SECONDS=80
DICTALAB_AI_TTS_MODE=legacy
DICTALAB_AI_COACH_MODE=legacy
DICTALAB_AI_REVIEW_MODE=legacy
DICTALAB_AI_CAPABILITY_CANARY_USERS=
