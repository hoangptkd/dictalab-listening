# Routing overlay. Ollama handles text AI, including legacy assessment callers.
SPRING_PROFILES_ACTIVE=local
DICTALAB_AI_PRODUCTION_MODE=false
DICTALAB_AI_PRIMARY_PROVIDER=ollama
DICTALAB_AI_TEXT_PROVIDER=ollama
DICTALAB_CONVERSATION_GENERATION_PROVIDER=ollama
DICTALAB_COACH_PROVIDER=ollama
DICTALAB_AI_JOBS_ENABLED=true
DICTALAB_AI_QUEUE_ENABLED=true
DICTALAB_LISTENING_QUEUE_ENABLED=true
# Explicit pilot controls; use canary plus an allowlist before python in production.
DICTALAB_AI_TTS_MODE=legacy
DICTALAB_AI_COACH_MODE=legacy
DICTALAB_AI_REVIEW_MODE=legacy
